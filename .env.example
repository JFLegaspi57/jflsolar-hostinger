# JFL Solar website (Laravel) — settings.
# On Hostinger: copy this file to jflsolar-app/.env (File Manager), fill in the
# values, and save. Never put real values in Git.

APP_NAME="JFL Solar"
# "production" on the live site, "local" on a developer machine.
APP_ENV=production
# A random secret. Generate one on the developer machine with:
#   php artisan key:generate --show
# Keep it the same after launch (changing it signs everyone out).
APP_KEY=
APP_DEBUG=false
# The site's address, no trailing slash, e.g. https://jflsolar.ph
APP_URL=https://jflsolar.ph
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# "production" only on the live site: search engines allowed, sample items and
# unconfirmed claims hidden. Anything else = preview (noindex, samples labelled).
SITE_ENV=preview
# Live mode only. "false" keeps search engines out while the live-mode site is on a
# temporary address (e.g. *.hostingersite.com) — remove it or set "true" on the real domain.
SEARCH_INDEXING=true

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL database (hPanel → Databases → MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Email alerts for new inquiries, sent through the business mailbox on
# Hostinger (hPanel → Emails). Leave INQUIRY_NOTIFY_EMAIL empty to keep
# inquiries in the admin only. Inquiries are always saved in the admin.
INQUIRY_NOTIFY_EMAIL=
INQUIRY_DAILY_CAP=80

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="JFL Solar Website"

# Online shop: cart, pay at pickup and/or PayMongo checkout (docs/HOSTINGER.md, section 11).
# On by default (launched 2026-10-31); SHOP_ENABLED=false switches it off. With pay at pickup on (the default) no PayMongo account is
# needed; add the PayMongo values below to let customers pay online as well.
SHOP_ENABLED=true
# Customers may reserve online and pay in person when collecting.
SHOP_PAY_IN_PERSON=true
# Ways to pay at pickup the customer can choose at checkout (cash, gcash, bank_transfer, check).
SHOP_IN_PERSON_METHODS=cash,gcash,bank_transfer,check,card
# Pay-at-pickup orders one visitor may place per day.
SHOP_RESERVATIONS_PER_DAY=3
# Pickup places offered (warehouse, office). Default: warehouse only.
SHOP_PICKUP_LOCATIONS=warehouse
# While the shop is off, signed-in staff still see it (labelled "Staff preview"; checkout
# saves nothing and charges nothing). Set to false to hide it from staff too.
SHOP_STAFF_PREVIEW=true
# Secret key: PayMongo Dashboard → Developers → API keys. Use sk_test_… to try it,
# then sk_live_… once PayMongo has activated the account.
PAYMONGO_SECRET_KEY=
# Signing secret (whsk_…) of the webhook for https://<your site>/webhooks/paymongo,
# event checkout_session.payment.paid. Test and live webhooks have different secrets.
PAYMONGO_WEBHOOK_SECRET=
# Payment methods shown on PayMongo's page; each must be enabled on your PayMongo account.
PAYMONGO_METHODS=qrph,gcash,paymaya,card
# Largest order total (₱) accepted online; bigger orders are sent to the quotation form.
SHOP_MAX_TOTAL=300000
# Where paid-order alerts are emailed (comma-separate several). Empty = INQUIRY_NOTIFY_EMAIL.
ORDER_NOTIFY_EMAIL=
